    "拍过就不能中途卸，拍满才能洗" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once you shoot, finish the roll before developing."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撮ったら途中では出せない。撮り切ってから現像。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "찍기 시작하면 중간에 뺄 수 없습니다. 다 찍은 뒤 현상."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍过就不能中途卸，拍满才能洗"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍過就不能中途卸，拍滿才能洗"
          }
        }
      }
    },
    "拍过就不能中途卸卷" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, a started roll must be finished before unloading. Turn off to unload early; unused frames are discarded."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンの場合、撮影を始めたフィルムは撮り切るまで取り出せません。オフにすると途中で取り出せますが、残りのコマは使えなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 촬영을 시작한 롤은 끝까지 찍어야 꺼낼 수 있습니다. 끄면 중간에 꺼낼 수 있지만 남은 컷은 사용할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，开始拍摄的胶卷需拍满后才能卸卷。关闭可提前卸卷，剩余格数作废。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟後，開始拍攝的膠捲需拍滿後才能卸捲。關閉可提前卸捲，剩餘格數作廢。"
          }
        }
      }
    },
