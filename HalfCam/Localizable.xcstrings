    "每月赠 6" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 a month"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎月6枚"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每月赠 6"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每月贈 6"
          }
        }
      }
    },
    "每月赠免费 1 / 年卡 3 / 买断 6 张，过月重置。买的留下。一张清掉一卷等待。买的未用余数跟 iCloud 走，同一 Apple ID 重装可找回。没开 iCloud 则卸掉清掉。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monthly gift: free 1 / yearly 3 / lifetime 6, resets each month. Bought tickets stay. One ticket finishes one roll. Unused purchased tickets follow iCloud and can be restored on the same Apple ID after reinstalling. They are lost if iCloud is off."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎月付与：無料1 / 年額3 / 買い切り6。月が変わるとリセット。買った分は残る。1枚で1巻の待ちを終わらせる。未使用の購入分は iCloud 経由で同じ Apple ID なら再インストール後も戻る。iCloud を切っていると消える。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每月赠免费 1 / 年卡 3 / 买断 6 张，过月重置。买的留下。一张清掉一卷等待。买的未用余数跟 iCloud 走，同一 Apple ID 重装可找回。没开 iCloud 则卸掉清掉。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每月贈免費 1 / 年卡 3 / 買斷 6 張，過月重置。買的留下。一張清掉一捲等待。買的未用餘數跟 iCloud 走，同一 Apple ID 重裝可找回。沒開 iCloud 則卸掉清掉。"
          }
        }
      }
    },
    "每月赠免费 1 / 年卡 3 / 买断 6 张，过月重置。买的留下。一张清掉一卷等待。卸掉 App 余数会清掉，买的不能恢复。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monthly gift: free 1 / yearly 3 / lifetime 6, resets each month. Bought tickets stay. One ticket finishes one roll. Deleting the app clears the balance; purchases can't be restored."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎月付与：無料1 / 年額3 / 買い切り6。月が変わるとリセット。買った分は残る。1枚で1巻の待ちを終わらせる。アプリを消すと残数も消える。購入分は復元できない。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每月赠免费 1 / 年卡 3 / 买断 6 张，过月重置。买的留下。一张清掉一卷等待。卸掉 App 余数会清掉，买的不能恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每月贈免費 1 / 年卡 3 / 買斷 6 張，過月重置。買的留下。一張清掉一捲等待。卸掉 App 餘數會清掉，買的不能恢復。"
          }
        }
      }
    },
    "每月赠券过月清掉。买的留下，并跟 iCloud 走。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monthly tickets expire at the start of the next month. Purchased tickets do not expire; their balance syncs when iCloud is enabled."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎月の付与分は翌月初めに失効します。購入分に有効期限はなく、iCloudが有効な場合は残数が同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매월 증정된 티켓은 다음 달 초에 만료됩니다. 구매한 티켓은 만료되지 않으며, iCloud가 켜져 있으면 잔여 수량이 동기화됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每月赠券于次月初失效。购买的加急券不过期，开启 iCloud 后可同步余量。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每月贈券於次月初失效。購買的加急券不過期，開啟 iCloud 後可同步餘量。"
          }
        }
      }
    },
    "每月赠的加急券，按你当时的档位发放：免费 1 张，年卡 3 张，买断 6 张。到下个月初清掉，用不完作废。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monthly tickets depend on your plan: Free 1, Yearly 3, Lifetime 6. Unused monthly tickets expire at the start of the next month."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎月の付与枚数はプランにより異なります。無料1枚、年額3枚、買い切り6枚。未使用の付与分は翌月初めに失効します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매월 요금제에 따라 무료 1장, 연간 3장, 평생권 6장을 증정합니다. 사용하지 않은 월별 증정권은 다음 달 초에 만료됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每月按当前档位赠券：免费 1 张、年卡 3 张、买断 6 张。当月赠券于次月初失效，不累计。"
          }
        },
