    "三档都要等。免费和年卡可看广告 −8 分钟；买断无广告。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every plan waits. Free and yearly can watch ads −8 min. Lifetime has no ads."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのプランも待つ。無料と年額は広告で −8分。買い切りは広告なし。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 플랜이 기다립니다. 무료와 연간은 광고로 −8분. 평생권은 광고 없음."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "三档都要等。免费和年卡可看广告 −8 分钟；买断无广告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "三檔都要等。免費和年卡可看廣告 −8 分鐘；買斷無廣告。"
          }
        }
      }
    },
