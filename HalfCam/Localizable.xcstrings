{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "购买买断不会自动取消现有年卡。请在系统设置中取消年卡续订，以免继续扣费。" : {
      "comment" : "Shown only to existing yearly subscribers considering the separate lifetime product.",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Buying Lifetime does not cancel an existing yearly subscription. Cancel its renewal in Settings if you no longer need it." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "買い切りを購入しても、年額プランは自動で解約されません。不要な場合は、設定で年額プランの自動更新を停止してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "평생권을 구매해도 기존 연간 구독은 자동으로 취소되지 않습니다. 더 이상 필요하지 않다면 설정에서 연간 구독 갱신을 취소해 주세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "购买买断不会自动取消现有年卡。如不再需要年卡，请在系统设置中取消续订，避免继续扣费。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "購買買斷不會自動取消現有年卡。如不再需要年卡，請在系統設定中取消續訂，避免繼續扣款。" } }
      }
    },
    "卸卷不会返还本月已使用的装卷额度。" : {
      "comment" : "Appended to early-unload confirmation only for plans with a monthly roll limit.",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Unloading does not restore this month's used roll allowance." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "取り出しても、今月の装填可能本数は戻りません。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "롤을 꺼내도 이번 달에 사용한 롤 한도는 복구되지 않습니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "卸卷不会返还本月已使用的装卷额度。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "卸捲不會退還本月已使用的裝捲額度。" } }
      }
    },
    "购买待处理，完成后将自动更新。" : {
      "comment" : "StoreKit purchase result is pending, not failed or completed.",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Purchase pending. Access or tickets will update when it completes." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "購入は保留中です。完了すると利用権または券の残数が更新されます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "구매가 대기 중입니다. 완료되면 이용 권한이나 티켓 잔여 수량이 갱신됩니다." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "购买待处理，完成后会自动更新权益或加急券余量。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "購買待處理，完成後會自動更新權益或加急券餘量。" } }
      }
    },
    "正在购买" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Purchasing…" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "購入手続き中…" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "구매 처리 중…" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在购买…" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "正在購買…" } }
      }
    },
    "拍摄未保存，请重试" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Photo not saved. Please try again." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "写真を保存できませんでした。もう一度お試しください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "사진을 저장하지 못했습니다. 다시 시도해 주세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "照片未保存，请重试" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "照片未儲存，請重試" } }
      }
    },
    "显影未完成，底片已保留" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Development incomplete. Please try again." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "現像が完了していません。もう一度お試しください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "현상이 완료되지 않았습니다. 다시 시도해 주세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "显影未完成，请重试" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "顯影未完成，請重試" } }
      }
    },
    "重试显影" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Retry development" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "現像を再試行" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "현상 다시 시도" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重试显影" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "重試顯影" } }
      }
    },
    "记录保存失败，请检查存储空间" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not save app data. Check available storage." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "データを保存できませんでした。空き容量を確認してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "데이터를 저장하지 못했습니다. 저장 공간을 확인해 주세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "数据未保存，请检查可用空间" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "資料未儲存，請檢查可用空間" } }
      }
    },
    "记录读取失败，请保留 App 并重试" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not load your film library. Reopen the app; do not delete it." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "フィルムの記録を読み込めませんでした。Appを削除せず、開き直してください。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "필름 기록을 불러오지 못했습니다. 앱을 삭제하지 말고 다시 실행해 주세요." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法读取胶卷记录。请重新打开 App，勿删除 App。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法讀取膠捲記錄。請重新開啟 App，勿刪除 App。" } }
      }
    },
