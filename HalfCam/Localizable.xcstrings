    "一对、单格都带齿孔和 HALFCAM。关掉就出净片。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds sprocket holes and the HALFCAM mark to spreads and single frames. Turn off for borderless photos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2コマ組にも単独のコマにも、パーフォレーションとHALFCAMの文字を付けます。オフにすると枠なしで保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 컷 사진과 단독 컷에 필름 구멍과 HALFCAM 표시를 넣습니다. 끄면 테두리 없이 저장합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为对页和单格保留齿孔与 HALFCAM 标记。关闭后，导出不带片边的照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為對頁和單格保留齒孔與 HALFCAM 標記。關閉後，匯出不帶片邊的照片。"
          }
        }
      }
    },
    "一对带齿孔和 HALFCAM。单格不带边。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pairs keep sprockets and HALFCAM. Singles stay clean."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対はパーフォレーションと HALFCAM。1コマはそのまま。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "페어는 스프로킷과 HALFCAM. 한 장은 그대로."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一对带齿孔和 HALFCAM。单格不带边。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一對帶齒孔和 HALFCAM。單格不帶邊。"
          }
        }
      }
    },
    "一张清掉一卷等待。消耗型，卸掉 App 余数会清掉，不能恢复。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One ticket finishes one roll's wait. Consumable — deleting the app clears the balance. Can't restore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1枚で1巻の待ちを終わらせる。消耗型。アプリを消すと残数も消える。復元できない。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一张清掉一卷等待。消耗型，卸掉 App 余数会清掉，不能恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一張清掉一捲等待。消耗型，卸掉 App 餘數會清掉，不能恢復。"
          }
        }
      }
    },
