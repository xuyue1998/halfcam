        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HALF CAM"
          }
        }
      }
    },
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "HalfCam"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HALF CAM uses your camera to take half-frame photos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HALF CAMはハーフフレーム写真の撮影にカメラを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HALF CAM은 하프프레임 사진을 촬영하기 위해 카메라를 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 HALF CAM 使用相机，拍摄你的半格照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許 HALF CAM 使用相機，拍攝你的半格照片。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HALF CAM saves developed photos to Photos and, with full access, checks whether exported copies are still there to update their export status."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HALF CAMは現像済みの写真を「写真」に保存します。フルアクセスが許可されている場合は、書き出した写真が残っているかを確認し、書き出し状態を更新します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HALF CAM은 현상된 사진을 사진 앱에 저장합니다. 전체 접근이 허용된 경우 내보낸 사본이 남아 있는지 확인하여 내보내기 상태를 갱신합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HALF CAM 将已显影的照片保存到系统相册；在获得完整访问权限时，检查已导出的副本是否仍在，以更新导出状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HALF CAM 將已顯影的照片儲存至系統相簿；取得完整取用權限時，會檢查已匯出的副本是否仍在，以更新匯出狀態。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HALF CAM saves developed photos to Photos when you export them or when auto-export is enabled."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HALF CAMは書き出し時、または自動書き出しが有効な場合に、現像済みの写真を「写真」に保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HALF CAM은 사진을 내보내거나 자동 내보내기가 켜져 있을 때 현상된 사진을 사진 앱에 저장합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HALF CAM 在你导出照片或已开启自动导出时，将已显影的照片保存到系统相册。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HALF CAM 會在你匯出照片或已開啟自動匯出時，將已顯影的照片儲存至系統相簿。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
